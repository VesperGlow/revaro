+// CSS size and game coordinates remain unchanged when the physical drawing
+// buffer must fit the actual device limit. Never impose a fixed 2048px cap.
+fn bounded_surface_size(width: u32, height: u32, limit: u32) -> (u32, u32) {
+    let width = width.max(1);
+    let height = height.max(1);
+    let limit = limit.max(1);
+    let scale = (limit as f64 / width.max(height) as f64).min(1.0);
+    (
+        (width as f64 * scale).floor().max(1.0) as u32,
+        (height as f64 * scale).floor().max(1.0) as u32,
+    )
+}
