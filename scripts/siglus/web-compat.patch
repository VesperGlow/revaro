+
+// Use the same CSS-to-physical conversion as winit pointer events. Some
+// browsers/emulation paths report a device-pixel ResizeObserver box that does
+// not track devicePixelRatio, which would otherwise offset every game click.
+fn drawing_size(
+    canvas: Option<&web_sys::HtmlCanvasElement>,
+    scale: f32,
+    fallback_w: u32,
+    fallback_h: u32,
+) -> (u32, u32) {
+    if let Some(canvas) = canvas {
+        let width = canvas.client_width();
+        let height = canvas.client_height();
+        if width > 0 && height > 0 {
+            return (
+                ((width as f64 * scale as f64).round() as u32).max(1),
+                ((height as f64 * scale as f64).round() as u32).max(1),
+            );
+        }
+    }
+    (fallback_w.max(1), fallback_h.max(1))
+}
+
+// Use physical surface coordinates for both rendering and pointer inversion.
+// Browser size and DPR never change the game's logical screen size.
+fn fit_host_viewport(
+    host: &mut SiglusHost,
+    width: u32,
+    height: u32,
+    scale_factor: f32,
+    logical: (u32, u32),
+) -> (u32, u32, u32, u32) {
+    let width = width.max(1);
+    let height = height.max(1);
+    let scale = (width as f64 / logical.0 as f64).min(height as f64 / logical.1 as f64);
+    let w = (logical.0 as f64 * scale).round().max(1.0) as u32;
+    let h = (logical.1 as f64 * scale).round().max(1.0) as u32;
+    let x = width.saturating_sub(w) / 2;
+    let y = height.saturating_sub(h) / 2;
+    host.resize_with_logical_viewport(
+        width,
+        height,
+        scale_factor,
+        logical.0,
+        logical.1,
+        x,
+        y,
+        w,
+        h,
+    );
+    (x, y, w, h)
+}
+
+fn map_game_point(
+    x: f64,
+    y: f64,
+    viewport: (u32, u32, u32, u32),
+    logical: (u32, u32),
+) -> (f64, f64) {
+    (
+        (x - viewport.0 as f64) * logical.0 as f64 / viewport.2.max(1) as f64,
+        (y - viewport.1 as f64) * logical.1 as f64 / viewport.3.max(1) as f64,
+    )
+}
diff --git a/crates/siglus_scene_vm/src/movie/browser.rs b/crates/siglus_scene_vm/src/movie/browser.rs
new file mode 100644
index 0000000..ebc19d5
--- /dev/null
+++ b/crates/siglus_scene_vm/src/movie/browser.rs
@@ -0,0 +1,362 @@
+//! Browser movie decoder: retain a current frame and one look-ahead frame.
+//! Compressed resource and PCM still use the existing VFS/Kira interfaces.
+use super::*;
+
+type Decoded = (Arc<RgbaImage>, u64);
+
+enum Decoder {
+    Mpeg {
+        bytes: Vec<u8>,
+        offset: usize,
+        pipeline: na_mpeg2_decoder::MpegAvPipeline,
+        queued: VecDeque<Decoded>,
+        flushed: bool,
+        index: usize,
+        frame_ms: f64,
+    },
+    Omv {
+        decoder: siglus_omv_decoder::TheoraFile,
+        info: siglus_omv_decoder::VideoInfo,
+        packed: Vec<u8>,
+        width: i32,
+        height: i32,
+        kind: u32,
+        index: usize,
+        frame_ms: f64,
+    },
+}
+
+pub(super) struct BrowserMovie {
+    decoder: Decoder,
+    current: Option<Decoded>,
+    next: Option<Decoded>,
+    index: usize,
+    eof: bool,
+    audio: Option<MovieAudio>,
+    fps: Option<f32>,
+    total_ms: Option<u64>,
+    last_timer: u64,
+    last_used: u64,
+}
+
+impl BrowserMovie {
+    fn open(path: &Path, tick: u64) -> Result<Self> {
+        let bytes = read_movie_bytes(path)?;
+        let ext = path
+            .extension()
+            .and_then(|s| s.to_str())
+            .unwrap_or("")
+            .to_ascii_lowercase();
+        let (decoder, fps, audio) = if ext == "omv" {
+            let header = read_omv_header_from_bytes(&bytes).ok();
+            let mut decoder =
+                siglus_omv_decoder::TheoraFile::open_from_memory(extract_ogg_from_bytes(&bytes)?)?;
+            let info = decoder.info();
+            let width = header
+                .as_ref()
+                .map(|h| h.display_width as i32)
+                .unwrap_or(info.width);
+            let height = header
+                .as_ref()
+                .map(|h| h.display_height as i32)
+                .unwrap_or(info.height);
+            let fps = header
+                .as_ref()
+                .filter(|h| h.frame_time_us != 0)
+                .map(|h| 1_000_000.0 / h.frame_time_us as f32)
+                .or_else(|| (info.fps > 0.0).then_some(info.fps as f32));
+            let frame_ms = omv_frame_duration_ms(header.as_ref(), fps).unwrap_or(1000.0 / 30.0);
+            let kind = header
+                .as_ref()
+                .map(|h| h.theora_type)
+                .unwrap_or(siglus_assets::omv::OMV_THEORA_TYPE_YUV);
+            let (_, _, y, u, v) = omv_plane_layout(info.frame_width, info.frame_height, info.fmt);
+            let audio = decode_omv_audio(&mut decoder)?;
+            (
+                Decoder::Omv {
+                    decoder,
+                    info,
+                    packed: vec![0; y + u + v],
+                    width,
+                    height,
+                    kind,
+                    index: 0,
+                    frame_ms,
+                },
+                fps,
+                audio,
+            )
+        } else {
+            let fps = siglus_assets::mpeg2::find_sequence_header(
+                &bytes[..bytes.len().min(MPEG2_HEADER_PROBE_BYTES)],
+            )
+            .and_then(|h| siglus_assets::mpeg2::fps_from_frame_rate_code(h.frame_rate_code));
+            let mut samples = Vec::new();
+            let mut channels = None;
+            let mut rate = None;
+            let mut dropped = 0;
+            let mut audio_decoder = na_mpeg2_decoder::MpegAudioPipeline::new();
+            audio_decoder.push_with(&bytes, None, |chunk| {
+                append_mpeg2_audio_chunk_for_asset(
+                    path,
+                    &mut channels,
+                    &mut rate,
+                    &mut samples,
+                    &mut dropped,
+                    chunk,
+                )
+            })?;
+            audio_decoder.flush_with(|chunk| {
+                append_mpeg2_audio_chunk_for_asset(
+                    path,
+                    &mut channels,
+                    &mut rate,
+                    &mut samples,
+                    &mut dropped,
+                    chunk,
+                )
+            })?;
+            let audio = build_movie_audio_from_parts(path, samples, channels, rate)?;
+            (
+                Decoder::Mpeg {
+                    bytes,
+                    offset: 0,
+                    pipeline: na_mpeg2_decoder::MpegAvPipeline::new(),
+                    queued: VecDeque::new(),
+                    flushed: false,
+                    index: 0,
+                    frame_ms: 1000.0 / fps.unwrap_or(30.0).max(1.0) as f64,
+                },
+                fps,
+                audio,
+            )
+        };
+        let total_ms = audio.as_ref().and_then(|a| a.duration_ms);
+        Ok(Self {
+            decoder,
+            current: None,
+            next: None,
+            index: 0,
+            eof: false,
+            audio,
+            fps,
+            total_ms,
+            last_timer: 0,
+            last_used: tick,
+        })
+    }
+
+    pub(super) fn retained_memory(&self) -> (usize, usize, usize) {
+        let mut frames = 0;
+        let mut bytes = 0;
+        for (frame, _) in self.current.iter().chain(self.next.iter()) {
+            frames += 1;
+            bytes += frame.rgba.len();
+        }
+        if let Decoder::Mpeg { queued, .. } = &self.decoder {
+            for (frame, _) in queued {
+                frames += 1;
+                bytes += frame.rgba.len();
+            }
+        }
+        let pcm = self
+            .audio
+            .as_ref()
+            .map(|audio| audio.samples.len() * 2)
+            .unwrap_or(0);
+        (frames, bytes, pcm)
+    }
+
+    fn rewind(&mut self) -> Result<()> {
+        match &mut self.decoder {
+            Decoder::Mpeg {
+                offset,
+                pipeline,
+                queued,
+                flushed,
+                index,
+                ..
+            } => {
+                *offset = 0;
+                *pipeline = na_mpeg2_decoder::MpegAvPipeline::new();
+                queued.clear();
+                *flushed = false;
+                *index = 0;
+            }
+            Decoder::Omv { decoder, index, .. } => {
+                decoder.reset();
+                *index = 0;
+            }
+        }
+        self.current = None;
+        self.next = None;
+        self.index = 0;
+        self.eof = false;
+        Ok(())
+    }
+
+    fn decode_next(&mut self) -> Result<Option<Decoded>> {
+        match &mut self.decoder {
+            Decoder::Mpeg {
+                bytes,
+                offset,
+                pipeline,
+                queued,
+                flushed,
+                index,
+                frame_ms,
+            } => {
+                while queued.is_empty() && !*flushed {
+                    let mut collect = |event| {
+                        if let na_mpeg2_decoder::MpegAvEvent::Video(frame) = event {
+                            let pts = (*index as f64 * *frame_ms).round() as u64;
+                            *index += 1;
+                            queued.push_back((
+                                Arc::new(RgbaImage {
+                                    width: frame.width,
+                                    height: frame.height,
+                                    center_x: 0,
+                                    center_y: 0,
+                                    rgba: frame.rgba,
+                                }),
+                                pts,
+                            ));
+                        }
+                    };
+                    if *offset < bytes.len() {
+                        let end = (*offset + 8192).min(bytes.len());
+                        pipeline.push_with(&bytes[*offset..end], None, &mut collect)?;
+                        *offset = end;
+                    } else {
+                        pipeline.flush_with(&mut collect)?;
+                        *flushed = true;
+                    }
+                }
+                Ok(queued.pop_front())
+            }
+            Decoder::Omv {
+                decoder,
+                info,
+                packed,
+                width,
+                height,
+                kind,
+                index,
+                frame_ms,
+            } => {
+                if !decoder.read_video_frame(packed)? {
+                    return Ok(None);
+                }
+                let frame = Arc::new(RgbaImage {
+                    width: (*width).max(1) as u32,
+                    height: (*height).max(1) as u32,
+                    center_x: 0,
+                    center_y: 0,
+                    rgba: convert_omv_frame(
+                        packed,
+                        info.frame_width,
+                        info.frame_height,
+                        info.fmt,
+                        *width,
+                        *height,
+                        *kind,
+                    ),
+                });
+                let pts = (*index as f64 * *frame_ms).round() as u64;
+                *index += 1;
+                Ok(Some((frame, pts)))
+            }
+        }
+    }
+
+    fn poll(&mut self, timer: u64, loop_flag: bool) -> Result<Option<MovieStreamFrame>> {
+        let effective = if loop_flag {
+            self.total_ms
+                .filter(|ms| *ms > 0)
+                .map(|ms| timer % ms)
+                .unwrap_or(timer)
+        } else {
+            timer
+        };
+        if effective < self.last_timer {
+            self.rewind()?;
+        }
+        self.last_timer = effective;
+        let mut decoded = false;
+        // Bound work per engine frame. The caller clamps its playback clock if
+        // decoding cannot keep up, instead of decoding a whole movie in one call.
+        for _ in 0..4 {
+            if self.next.is_none() && !self.eof {
+                self.next = self.decode_next()?;
+                self.eof = self.next.is_none();
+            }
+            if self.current.is_some() && self.next.as_ref().is_none_or(|(_, pts)| *pts > effective)
+            {
+                break;
+            }
+            if let Some(next) = self.next.take() {
+                if self.current.is_some() {
+                    self.index += 1;
+                }
+                self.current = Some(next);
+                decoded = true;
+            } else {
+                break;
+            }
+        }
+        let Some((frame, pts)) = &self.current else {
+            return Ok(None);
+        };
+        let frame_ms = self
+            .fps
+            .filter(|fps| *fps > 0.0)
+            .map(|fps| (1000.0 / fps) as u64)
+            .unwrap_or(34)
+            .max(1);
+        if self.eof {
+            self.total_ms = Some(self.total_ms.unwrap_or(0).max(pts.saturating_add(frame_ms)));
+        }
+        let behind = !self.eof
+            && self
+                .next
+                .as_ref()
+                .is_none_or(|(_, next_pts)| *next_pts <= effective);
+        Ok(Some(MovieStreamFrame {
+            frame: frame.clone(),
+            frame_idx: self.index,
+            fps: self.fps,
+            total_ms: self.total_ms,
+            audio: self.audio.clone(),
+            audio_ready: true,
+            decoded_now: decoded,
+            frame_idx_is_decode_order: false,
+            clamped_timer_ms: behind.then_some(*pts),
+            source_size: Some((frame.width, frame.height)),
+        }))
+    }
+}
+
+impl MovieManager {
+    pub(super) fn poll_browser_movie(
+        &mut self,
+        path: PathBuf,
+        timer: u64,
+        looping: bool,
+    ) -> Result<Option<MovieStreamFrame>> {
+        self.browser_tick = self.browser_tick.wrapping_add(1);
+        let tick = self.browser_tick;
+        // Keep object movies used by the current scene; drop old scenes' decoders.
+        self.browser_movies
+            .retain(|_, movie| tick.wrapping_sub(movie.last_used) < 600);
+        if !self.browser_movies.contains_key(&path) {
+            self.browser_movies
+                .insert(path.clone(), BrowserMovie::open(&path, tick)?);
+        }
+        let movie = self
+            .browser_movies
+            .get_mut(&path)
+            .expect("browser movie inserted");
+        movie.last_used = tick;
+        movie.poll(timer, looping)
+    }
+}
diff --git a/crates/siglus_scene_vm/src/render/software.rs b/crates/siglus_scene_vm/src/render/software.rs
new file mode 100644
index 0000000..3e84567
--- /dev/null
+++ b/crates/siglus_scene_vm/src/render/software.rs
@@ -0,0 +1,326 @@
+//! Small CPU compositor used by browsers that expose neither WebGL2 nor WebGPU.
+//!
+//! It intentionally implements the common 2D Siglus path first. Meshes and
+//! advanced wipes continue to use the GPU renderer; ordinary dialogue scenes,
+//! backgrounds, portraits, alpha, tone and scaling are rendered directly into
+//! an RGBA framebuffer which the wasm shell presents with Canvas2D.
+
+use anyhow::Result;
+
+use crate::assets::RgbaImage;
+use crate::image_manager::ImageManager;
+use crate::layer::{RenderFrame, RenderSprite, SpriteBlend, SpriteFit, SpriteSizeMode};
+use crate::render_math::sprite_quad_geometry_rect;
+use crate::render_plan::{src_clip_rect, tona_src_clip_local_rect};
+use crate::runtime::FrameCaptureBackend;
+
+pub struct SoftwareRenderer {
+    logical_width: u32,
+    logical_height: u32,
+    surface_width: u32,
+    surface_height: u32,
+    scale_factor: f32,
+    viewport: (u32, u32, u32, u32),
+    frame: Vec<u8>,
+    pub drawn_sprites: u32,
+    pub missing_images: u32,
+}
+
+impl SoftwareRenderer {
+    pub fn new(width: u32, height: u32) -> Self {
+        let width = width.max(1);
+        let height = height.max(1);
+        Self {
+            logical_width: width,
+            logical_height: height,
+            surface_width: width,
+            surface_height: height,
+            scale_factor: 1.0,
+            viewport: (0, 0, width, height),
+            frame: vec![0; (width as usize) * (height as usize) * 4],
+            drawn_sprites: 0,
+            missing_images: 0,
+        }
+    }
+
+    pub fn adapter_name(&self) -> String {
+        "software Canvas2D".to_owned()
+    }
+
+    pub fn scale_factor(&self) -> f32 {
+        self.scale_factor
+    }
+
+    pub fn logical_size(&self) -> (u32, u32) {
+        (self.logical_width, self.logical_height)
+    }
+
+    pub fn surface_viewport(&self) -> (u32, u32, u32, u32) {
+        self.viewport
+    }
+
+    pub fn screen_viewport(&self) -> [u32; 4] {
+        [
+            self.viewport.0,
+            self.viewport.1,
+            self.viewport.2,
+            self.viewport.3,
+        ]
+    }
+
+    pub fn resize_with_logical_viewport(
+        &mut self,
+        surface_width: u32,
+        surface_height: u32,
+        scale_factor: f32,
+        logical_width: u32,
+        logical_height: u32,
+        viewport_x: u32,
+        viewport_y: u32,
+        viewport_width: u32,
+        viewport_height: u32,
+    ) {
+        self.surface_width = surface_width.max(1);
+        self.surface_height = surface_height.max(1);
+        self.scale_factor = if scale_factor.is_finite() && scale_factor > 0.0 {
+            scale_factor
+        } else {
+            1.0
+        };
+        self.logical_width = logical_width.max(1);
+        self.logical_height = logical_height.max(1);
+        self.viewport = (
+            viewport_x,
+            viewport_y,
+            viewport_width.max(1),
+            viewport_height.max(1),
+        );
+        let expected = (self.logical_width as usize) * (self.logical_height as usize) * 4;
+        if self.frame.len() != expected {
+            self.frame.resize(expected, 0);
+        }
+    }
+
+    pub fn render_frame(&mut self, images: &ImageManager, frame: &RenderFrame) -> Result<()> {
+        self.frame.fill(0);
+        self.drawn_sprites = 0;
+        self.missing_images = 0;
+        let sprites = frame.debug_flatten();
+        for item in sprites.iter().filter(|item| item.sprite.visible) {
+            self.draw_sprite(images, item);
+        }
+        Ok(())
+    }
+
+    pub fn frame(&self) -> &[u8] {
+        &self.frame
+    }
+
+    pub fn clear_runtime_image_textures(&mut self) {}
+    pub fn dump_next_frame(&mut self, _path: std::path::PathBuf) {}
+
+    fn draw_sprite(&mut self, images: &ImageManager, item: &RenderSprite) {
+        let sprite = &item.sprite;
+        let Some(image_id) = sprite.image_id.as_ref() else {
+            return;
+        };
+        let Some(image) = images.get(image_id) else {
+            self.missing_images += 1;
+            return;
+        };
+        self.drawn_sprites += 1;
+        // Match the GPU planner's local coordinates, clipping and transform.
+        // OBJECT.X/Y is an anchor with an explicit texture center, not always
+        // the middle of the image. Subtracting another half-size here cropped
+        // origin-anchored startup backgrounds into the top-left quarter.
+        let (x, y, left, top, right, bottom, u0, v0, u1, v1) = match sprite.fit {
+            SpriteFit::FullScreen => {
+                let Ok((l, t, r, b)) = src_clip_rect(sprite.src_clip, image.width, image.height)
+                else {
+                    return;
+                };
+                (
+                    0.0,
+                    0.0,
+                    0.0,
+                    0.0,
+                    self.logical_width as f32,
+                    self.logical_height as f32,
+                    l / image.width.max(1) as f32,
+                    t / image.height.max(1) as f32,
+                    r / image.width.max(1) as f32,
+                    b / image.height.max(1) as f32,
+                )
+            }
+            SpriteFit::PixelRect => {
+                let (w, h) = match sprite.size_mode {
+                    SpriteSizeMode::Intrinsic => {
+                        (image.width.max(1) as f32, image.height.max(1) as f32)
+                    }
+                    SpriteSizeMode::Explicit { width, height } => {
+                        (width.max(1) as f32, height.max(1) as f32)
+                    }
+                };
+                let Some((l, t, r, b)) = tona_src_clip_local_rect(sprite, w, h) else {
+                    return;
+                };
+                (
+                    sprite.x as f32,
+                    sprite.y as f32,
+                    l,
+                    t,
+                    r,
+                    b,
+                    l / w,
+                    t / h,
+                    r / w,
+                    b / h,
+                )
+            }
+        };
+        let Some(quad) = sprite_quad_geometry_rect(
+            sprite,
+            x,
+            y,
+            left,
+            top,
+            right,
+            bottom,
+            self.logical_width as f32,
+            self.logical_height as f32,
+        ) else {
+            return;
+        };
+        let points = quad.projected;
+        let origin = points[0];
+        let ax = points[1].x - origin.x;
+        let ay = points[1].y - origin.y;
+        let bx = points[3].x - origin.x;
+        let by = points[3].y - origin.y;
+        let determinant = ax * by - ay * bx;
+        if !determinant.is_finite() || determinant.abs() < 1e-6 {
+            return;
+        }
+        let mut x0 = points
+            .iter()
+            .map(|p| p.x)
+            .fold(f32::INFINITY, f32::min)
+            .floor()
+            .max(0.0) as i32;
+        let mut y0 = points
+            .iter()
+            .map(|p| p.y)
+            .fold(f32::INFINITY, f32::min)
+            .floor()
+            .max(0.0) as i32;
+        let mut x1 = points
+            .iter()
+            .map(|p| p.x)
+            .fold(f32::NEG_INFINITY, f32::max)
+            .ceil()
+            .min(self.logical_width as f32) as i32;
+        let mut y1 = points
+            .iter()
+            .map(|p| p.y)
+            .fold(f32::NEG_INFINITY, f32::max)
+            .ceil()
+            .min(self.logical_height as f32) as i32;
+        if let Some(clip) = sprite.dst_clip {
+            x0 = x0.max(clip.left);
+            y0 = y0.max(clip.top);
+            x1 = x1.min(clip.right);
+            y1 = y1.min(clip.bottom);
+        }
+        let alpha = u32::from(sprite.alpha);
+        if alpha == 0 {
+            return;
+        }
+        for py in y0..y1 {
+            for px in x0..x1 {
+                let dx = px as f32 + 0.5 - origin.x;
+                let dy = py as f32 + 0.5 - origin.y;
+                let a = (dx * by - dy * bx) / determinant;
+                let b = (ax * dy - ay * dx) / determinant;
+                if !(0.0..1.0).contains(&a) || !(0.0..1.0).contains(&b) {
+                    continue;
+                }
+                let u = (u0 + a * (u1 - u0)).clamp(0.0, 1.0);
+                let v = (v0 + b * (v1 - v0)).clamp(0.0, 1.0);
+                let sx = ((u * image.width as f32).floor() as u32).min(image.width - 1);
+                let sy = ((v * image.height as f32).floor() as u32).min(image.height - 1);
+                let si = ((sy * image.width + sx) * 4) as usize;
+                let di = ((py as u32 * self.logical_width + px as u32) * 4) as usize;
+                let sa = u32::from(image.rgba[si + 3]) * alpha / 255;
+                if sa == 0 {
+                    continue;
+                }
+                let sr = tone(image.rgba[si], sprite);
+                let sg = tone(image.rgba[si + 1], sprite);
+                let sb = tone(image.rgba[si + 2], sprite);
+                blend_pixel(
+                    &mut self.frame[di..di + 4],
+                    [sr, sg, sb, sa as u8],
+                    sprite.blend,
+                );
+            }
+        }
+    }
+}
+
+fn tone(value: u8, sprite: &crate::layer::Sprite) -> u8 {
+    let mut value = u32::from(value);
+    if sprite.mono != 0 {
+        value = value.saturating_mul(77 + 150 + 29) / 256;
+    }
+    if sprite.bright != 0 {
+        value = value.saturating_add(u32::from(sprite.bright));
+    }
+    if sprite.color_rate != 0 {
+        value = value.saturating_mul(u32::from(sprite.color_rate)) / 255;
+    }
+    value
+        .saturating_add(u32::from(
+            sprite
+                .color_add_r
+                .max(sprite.color_add_g)
+                .max(sprite.color_add_b),
+        ))
+        .min(255) as u8
+}
+
+fn blend_pixel(dst: &mut [u8], src: [u8; 4], blend: SpriteBlend) {
+    let sa = u32::from(src[3]);
+    let inv = 255 - sa;
+    for channel in 0..3 {
+        let s = u32::from(src[channel]);
+        let d = u32::from(dst[channel]);
+        let value = match blend {
+            SpriteBlend::Add => (d + s * sa / 255).min(255),
+            SpriteBlend::Sub => d.saturating_sub(s * sa / 255),
+            SpriteBlend::Mul => d * (s * sa / 255 + inv) / 255,
+            SpriteBlend::Screen => 255 - (255 - d) * (255 - s * sa / 255) / 255,
+            _ => (s * sa + d * inv) / 255,
+        };
+        dst[channel] = value as u8;
+    }
+    dst[3] = (sa + u32::from(dst[3]) * inv / 255).min(255) as u8;
+}
+
+impl FrameCaptureBackend for SoftwareRenderer {
+    fn capture_render_frame(
+        &mut self,
+        images: &ImageManager,
+        frame: &RenderFrame,
+        _logical_width: u32,
+        _logical_height: u32,
+    ) -> Result<RgbaImage> {
+        self.render_frame(images, frame)?;
+        Ok(RgbaImage {
+            width: self.logical_width,
+            height: self.logical_height,
+            center_x: 0,
+            center_y: 0,
+            rgba: self.frame.clone(),
+        })
+    }
+}
