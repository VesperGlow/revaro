+        match self { RenderBackend::Gpu(r) => r.borrow_mut().resize_with_scale(width,height,scale), RenderBackend::Software(r) => r.borrow_mut().resize_with_logical_viewport(width,height,scale,width.max(1),height.max(1),0,0,width.max(1),height.max(1)) }
+    }
+    fn set_wait_display_vsync(&self, wait: bool) { if let RenderBackend::Gpu(r) = self { r.borrow_mut().set_wait_display_vsync(wait); } }
+    fn render_frame(&self, images: &ImageManager, frame: &RenderFrame) -> Result<()> {
+        match self { Self::Gpu(r) => r.borrow_mut().render_frame(images, frame), Self::Software(r) => r.borrow_mut().render_frame(images, frame) }
+    }
+    fn clear_runtime_image_textures(&self) {
+        match self { Self::Gpu(r) => r.borrow_mut().clear_runtime_image_textures(), Self::Software(r) => r.borrow_mut().clear_runtime_image_textures() }
+    }
+    fn scale_factor(&self) -> f32 { match self { Self::Gpu(r) => r.borrow().scale_factor(), Self::Software(r) => r.borrow().scale_factor() } }
+    fn surface_viewport(&self) -> (u32,u32,u32,u32) { match self { Self::Gpu(r) => r.borrow().surface_viewport(), Self::Software(r) => r.borrow().surface_viewport() } }
+    fn logical_size(&self) -> (u32,u32) { match self { Self::Gpu(r) => r.borrow().logical_size(), Self::Software(r) => r.borrow().logical_size() } }
+    fn screen_viewport(&self) -> [u32;4] { let (x,y,w,h) = self.surface_viewport(); [x,y,w,h] }
+    fn frame(&self) -> Option<Vec<u8>> { match self { Self::Gpu(_) => None, Self::Software(r) => Some(r.borrow().frame().to_vec()) } }
+    fn dump_next_frame(&self, _path: PathBuf) {}
+}
+
+pub struct RenderBackendRefMut<'a> { inner: &'a mut RenderBackend }
+impl RenderBackendRefMut<'_> {
+    pub fn scale_factor(&self) -> f32 { self.inner.scale_factor() }
+    pub fn logical_size(&self) -> (u32,u32) { self.inner.logical_size() }
+    pub fn surface_viewport(&self) -> (u32,u32,u32,u32) { self.inner.surface_viewport() }
+    pub fn screen_viewport(&self) -> [u32;4] { self.inner.screen_viewport() }
+    pub fn dump_next_frame(&mut self, path: PathBuf) { self.inner.dump_next_frame(path) }
+    pub fn replace_surface_from_raw_handles(&mut self, display: raw_window_handle::RawDisplayHandle, window: raw_window_handle::RawWindowHandle, width: u32, height: u32) -> Result<()> {
+        match &mut *self.inner {
+            RenderBackend::Gpu(renderer) => unsafe { renderer.borrow_mut().replace_surface_from_raw_handles(display, window, width, height) },
+            RenderBackend::Software(_) => Ok(()),
+        }
+    }
+}
+
