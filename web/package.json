{
  "name": "revaro-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run src --pool=vmThreads --maxWorkers=1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "e2e": "playwright test",
    "benchmark:reader": "playwright test e2e/reader-flow.spec.ts --grep @benchmark"
  },
  "dependencies": {
    "@lucide/vue": "1.43.0",
    "dompurify": "3.4.15",
    "marked": "18.0.12",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  }
}
