APP_ADDR=:8080
APP_DATA_DIR=/data
APP_WORK_DIR=/work
APP_BASE_URL=http://localhost:8080
COOKIE_SECURE=false

ADMIN_USERNAME=admin
# 可选；留空时首次启动会将一次性随机密码写入 APP_DATA_DIR 下的 0600 文件。
ADMIN_PASSWORD=
# 仅信任这些反向代理 CIDR 提供的 X-Forwarded-For；留空时始终使用直连地址。
# TRUSTED_PROXIES=10.0.0.0/8,fd00::/8

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=revaro
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio
S3_PATH_STYLE=true
# 仅用于尚未迁移的旧整对象；新 blobs 始终通过 Presigned URL 直连公网 endpoint。
# UpCloud endpoint 默认 true，其他 S3 默认 false；需要时可手动覆盖。
# S3_PROXY_TRANSFERS=false

PRESIGN_EXPIRES=15m
# FFmpeg HLS fallback 的有限 SSD 临时缓存总上限（默认 2 GiB）。
MEDIA_CACHE_CAPACITY=2147483648
UPLOAD_EXPIRES=24h
# 回收站项目保留 30 天后自动永久删除；0 表示禁用自动清理。
TRASH_RETENTION=720h
GC_INTERVAL=1h
# 内置磁力 / BT 离线下载。BT_PORT 是宿主机公开的 TCP+UDP 监听端口。
BT_ENABLED=true
BT_PORT=51413
BT_MAX_FILES=10000
BT_MAX_TOTAL_SIZE=1099511627776
BT_METADATA_TIMEOUT=30m
BT_STALE_AFTER=48h
# 媒体转码/抽帧/元数据探测由内置 Rust 数据平面（libav）完成，无需 ffmpeg CLI。

# 每天自动把 SQLite 一致性快照（VACUUM INTO）备份到 S3 的 revaro-backups/database/，
# 保留最近 14 份；备份失败只记录日志，不影响主服务。
# BACKUP_ENABLED=true
# BACKUP_INTERVAL=24h
# BACKUP_RETENTION=14

# 阅读器 reading flow（flows/ 前缀）缓存回收：超过 TTL 或总容量上限时淘汰
# 最旧产物；分页完全在浏览器端 CSS columns 完成，无 Chromium 依赖。
# FLOW_CACHE_TTL=720h
# FLOW_CACHE_CAPACITY=1073741824
