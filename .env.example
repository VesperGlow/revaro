APP_ADDR=:8080
APP_DATA_DIR=/data
APP_BASE_URL=http://localhost:8080
COOKIE_SECURE=false

ADMIN_USERNAME=admin
# 可选；留空时首次启动会生成一次性随机密码并打印到 revaro 容器日志。
ADMIN_PASSWORD=

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=revaro
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio
S3_PATH_STYLE=true
# UpCloud endpoint 会自动设为 true，让上传/下载经 revaro 转发并允许关闭公网 S3 endpoint。
# 其他 S3 默认 false（浏览器使用 Presigned URL 直传）；需要时可手动覆盖。
# S3_PROXY_TRANSFERS=false

PRESIGN_EXPIRES=15m
BLOCK_SIZE=4194304
# FastCDC 可变分块边界；不设置时分别为 BLOCK_SIZE / 4 与 BLOCK_SIZE * 4。
FASTCDC_MIN_SIZE=1048576
FASTCDC_MAX_SIZE=16777216
# 全局 RAM LRU + 本地 SSD 持久 block cache；容量为字节，0 表示禁用。
BLOCK_RAM_CACHE_CAPACITY=268435456
BLOCK_SSD_CACHE_CAPACITY=8589934592
# 写 cache 后至少保留 2 GiB 可用空间，避免撑满 /data 所在磁盘。
BLOCK_CACHE_MIN_FREE=2147483648
BLOCK_CACHE_DIR=/data/block-cache
# 视频、音频、下载与解压连续读取保持 256 MiB ahead；0 退回普通 3-block 预取。
BLOCK_READ_AHEAD=268435456
UPLOAD_EXPIRES=24h
# 回收站项目保留 30 天后自动永久删除；0 表示禁用自动清理。
TRASH_RETENTION=720h
GC_INTERVAL=1h
# 内置磁力 / BT 离线下载。BT_PORT 是宿主机公开的 TCP+UDP 监听端口。
BT_ENABLED=true
BT_PORT=51413
BT_MAX_FILES=10000
BT_MAX_TOTAL_SIZE=1099511627776
BT_METADATA_TIMEOUT=30m
BT_STALE_AFTER=48h
# 可选：视频缩略图抽帧使用的 ffmpeg 可执行文件路径（默认 PATH 中的 ffmpeg）
# FFMPEG_PATH=ffmpeg
