# Local file storage is persisted by the /data volume (objects/blobs/<UUID>).
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
COOKIE_SECURE=false
ADMIN_USERNAME=admin
# Leave empty to generate credentials in /data/initial-admin-credentials.
ADMIN_PASSWORD=
TRUSTED_PROXIES=
MEDIA_CACHE_CAPACITY=2147483648
UPLOAD_EXPIRES=24h
TRASH_RETENTION=720h
GC_INTERVAL=1h
FLOW_CACHE_TTL=720h
FLOW_CACHE_CAPACITY=1073741824
