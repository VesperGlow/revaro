# SQLite lives in /data, persistent files in /objects, rebuildable caches in /caches.
# Native server / host networking: HTTP listen address and port.
APP_ADDR=127.0.0.1:8080
# Bridged Compose publishes this host IP/port to container HTTP port 8080.
APP_BIND_IP=127.0.0.1
APP_PORT=8080
# Set to the public reverse-proxy origin, e.g. https://files.example.com.
# Empty in Compose defaults to http://localhost:${APP_PORT}.
APP_BASE_URL=
# Leave empty to follow APP_BASE_URL (Secure is enabled automatically for HTTPS).
COOKIE_SECURE=
ADMIN_USERNAME=admin
# Leave empty to generate credentials in /data/initial-admin-credentials.
ADMIN_PASSWORD=
# Comma-separated proxy CIDRs only; empty means no forwarded headers are trusted.
TRUSTED_PROXIES=
MEDIA_CACHE_CAPACITY=2147483648
APP_MEMORY_BUDGET=8589934592
UPLOAD_EXPIRES=24h
UPLOAD_IDLE_TIMEOUT=60s
UPLOAD_REQUEST_TIMEOUT=24h
UPLOAD_MIN_FREE_BYTES=67108864
UPLOAD_CONCURRENCY=8
TRASH_RETENTION=720h
GC_INTERVAL=1h
FLOW_CACHE_TTL=720h
FLOW_CACHE_CAPACITY=1073741824
