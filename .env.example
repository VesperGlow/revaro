# Local file storage is persisted by the /data volume (objects/blobs/<UUID>).
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
COOKIE_SECURE=false
ADMIN_USERNAME=admin
# Leave empty to generate credentials in /data/initial-admin-credentials.
ADMIN_PASSWORD=
TRUSTED_PROXIES=
MEDIA_CACHE_CAPACITY=2147483648
UPLOAD_EXPIRES=24h
TRASH_RETENTION=720h
GC_INTERVAL=1h
FLOW_CACHE_TTL=720h
FLOW_CACHE_CAPACITY=1073741824

# Optional S3 database backups. With an empty switch, enabled if S3_BUCKET is set.
BACKUP_ENABLED=
BACKUP_INTERVAL=24h
BACKUP_RETENTION=14
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=false
