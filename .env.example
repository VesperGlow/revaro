# SQLite lives in /data, persistent files in /objects, rebuildable caches in /caches.
APP_PORT=8080
# Leave empty to derive http://localhost:$APP_PORT; set the public URL when using a proxy.
APP_BASE_URL=
# Optional HTTPS URL on the same hostname and a distinct port, serving HTTP/2 only.
APP_HTTP2_BASE_URL=
# Optional native HTTPS/HTTP/3. Use full IP:port addresses and a real TLS certificate.
# Native listener ports must match the configured public HTTPS ports.
APP_TLS_ADDR=
APP_TLS_CERT=
APP_TLS_KEY=
APP_HTTP2_ADDR=
APP_QUIC_ADDR=
# standard = Cubic; aggressive = bounded target-rate loss compensation.
QUIC_CC_MODE=aggressive
# auto (or empty) probes available bandwidth; a number pins a fixed target in decimal Mbps.
QUIC_TARGET_MBPS=auto
QUIC_MAX_MBPS=250
QUIC_GLOBAL_MAX_MBPS=1000
QUIC_MAX_COMPENSATION_PERCENT=125
QUIC_MAX_WINDOW_MIB=8
QUIC_MAX_CONNECTIONS=32
# Leave empty to follow APP_BASE_URL (Secure is enabled automatically for HTTPS).
COOKIE_SECURE=
ADMIN_USERNAME=admin
# Leave empty to generate credentials in /data/initial-admin-credentials.
ADMIN_PASSWORD=
TRUSTED_PROXIES=
MEDIA_CACHE_CAPACITY=2147483648
UPLOAD_EXPIRES=24h
UPLOAD_IDLE_TIMEOUT=60s
UPLOAD_REQUEST_TIMEOUT=24h
UPLOAD_MIN_FREE_BYTES=67108864
UPLOAD_CONCURRENCY=8
TRASH_RETENTION=720h
GC_INTERVAL=1h
FLOW_CACHE_TTL=720h
FLOW_CACHE_CAPACITY=1073741824
