APP_ADDR=:8080
APP_DATA_DIR=/data
APP_WORK_DIR=/data/work
APP_BASE_URL=http://localhost:8080
COOKIE_SECURE=false

ADMIN_USERNAME=admin
# 可选；留空时首次启动会生成一次性随机密码并打印到 revaro 容器日志。
ADMIN_PASSWORD=

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=revaro
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio
S3_PATH_STYLE=true
# 仅用于尚未迁移的旧整对象；新 blobs 始终通过 Presigned URL 直连公网 endpoint。
# UpCloud endpoint 默认 true，其他 S3 默认 false；需要时可手动覆盖。
# S3_PROXY_TRANSFERS=false

PRESIGN_EXPIRES=15m
BLOCK_SIZE=4194304
# FastCDC 可变分块边界；不设置时分别为 BLOCK_SIZE / 4 与 BLOCK_SIZE * 4。
FASTCDC_MIN_SIZE=1048576
FASTCDC_MAX_SIZE=16777216
# 旧 manifest 兼容 Reader 的可选 block cache；默认关闭，迁移完成后可删除这些配置。
BLOCK_RAM_CACHE_CAPACITY=0
BLOCK_SSD_CACHE_CAPACITY=0
BLOCK_CACHE_MIN_FREE=0
BLOCK_CACHE_DIR=/data/block-cache
# FFmpeg HLS fallback 的有限 SSD 临时缓存总上限（默认 2 GiB）。
MEDIA_CACHE_CAPACITY=2147483648
UPLOAD_EXPIRES=24h
# 回收站项目保留 30 天后自动永久删除；0 表示禁用自动清理。
TRASH_RETENTION=720h
GC_INTERVAL=1h
# 内置磁力 / BT 离线下载。BT_PORT 是宿主机公开的 TCP+UDP 监听端口。
BT_ENABLED=true
BT_PORT=51413
BT_MAX_FILES=10000
BT_MAX_TOTAL_SIZE=1099511627776
BT_METADATA_TIMEOUT=30m
BT_STALE_AFTER=48h
# 可选：视频缩略图抽帧使用的 ffmpeg 可执行文件路径（默认 PATH 中的 ffmpeg）
# FFMPEG_PATH=ffmpeg
